{{#each services}}
<div class="service-card">
    <h3>Nombre del servicio: {{this.name}}</h3>
    <p>Descripción: {{this.description}}</p>
    <p>Duración: {{this.duration}}</p>
    <p>Precio: {{this.price}}</p>
    <p>Categoría: {{this.category}}</p>
    <p>Disponible: {{this.available}}</p>
</div>
{{/each}}